<Project>

  <!-- LADR-0003, "Package management": Central Package Management, all versions
       pinned, given how many .NET staples relicensed in 2024-25. The Domain has
       zero PackageReference by design; Marten is pinned here but referenced only
       from Soarscore.Infrastructure (LADR-0001 §4.1-3). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="Marten" Version="9.22.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Transitive via Marten -> Weasel.Postgresql, pinned to match rather than
         float independently (LADR-0003 "all versions pinned"). -->
    <PackageVersion Include="Npgsql" Version="9.0.4" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
