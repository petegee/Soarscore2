<Project>

  <!-- LADR-0003, "Package management": Central Package Management, all versions
       pinned, given how many .NET staples relicensed in 2024-25. The Domain has
       zero PackageReference by design; Marten is pinned here but referenced only
       from Soarscore.Infrastructure (LADR-0001 §4.1-3). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="CsCheck" Version="4.8.0" />
    <PackageVersion Include="Marten" Version="9.22.2" />
    <!-- Pinned to the AspNetCore.App runtime installed alongside the 10.0.110 SDK
         (LADR-0003 "API documentation": in-box, spec emitted as a build artefact). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- capture-a-score-steel-thread-plan.md WI-13: WebApplicationFactory, so the
         Reqnroll acceptance suite drives the real Soarscore.Api over real HTTP
         rather than through IDispatcher (LADR-0003 "Test entry point"'s prior
         stance — this is the first suite that needs it). Same 10.0.10 as
         Microsoft.AspNetCore.OpenApi above, the AspNetCore.App runtime the SDK carries. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- Transitive via Microsoft.AspNetCore.OpenApi, which pins 2.0.0 — GHSA-v5pm-xwqc-g5wc
         (stack overflow parsing a circular-reference OpenAPI document), patched at 2.7.5.
         Overridden explicitly rather than left floating (CentralPackageTransitivePinningEnabled). -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Transitive via Marten -> Weasel.Postgresql, pinned to match rather than
         float independently (LADR-0003 "all versions pinned"). -->
    <PackageVersion Include="Npgsql" Version="9.0.4" />
    <!-- Transitive via Testcontainers.PostgreSql -> Testcontainers (SSH tunnelling
         to remote Docker hosts). 2025.1.0 and earlier carry GHSA-q939-rpr3-3284
         (ScpClient recursive-download path traversal); patched at 2026.0.0.
         Overridden explicitly rather than left floating (CentralPackageTransitivePinningEnabled). -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- capture-a-score-steel-thread-plan.md WI-13, LADR-0003's Reqnroll entry:
         Gherkin/BDD over xunit.v3 — repo's xunit.v3 3.2.2 / xunit.runner.visualstudio
         3.1.5 satisfy the ≥3.0.2 floor Reqnroll.xunit.v3 3.3.4 declares. -->
    <PackageVersion Include="Reqnroll.xunit.v3" Version="3.3.4" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <PackageVersion Include="Verify.XunitV3" Version="31.28.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
