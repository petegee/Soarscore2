# F3B — RC Multi-Task Gliders                  seed definition, draft
# Rule refs: FAI Sporting Code Volume F3 Soaring 2025 ed.2 (F3B.x)
#
# The structural outlier, and the reason Task owns normalisation, group
# constraints, rounding and flight-time precision rather than the class or the
# round. Every one of those differs between A, B and C inside this one file.

class F3B
  name     "RC Multi-Task Gliders"
  fai      "F3B"
  version  "FAI F3 Soaring 2025 ed.2"

  param minRounds    Number default 1  allowed [1, 5] boundAt CompetitionSetup  # F3B.1.8 b — 1 normally, 5 at World/Continental Championships
  param minNewGroup  Number no default                boundAt CompetitionSetup  # F3B states no minimum for a re-flight group (F12)

  finalRanking SinglePhase                                      # F3B has no fly-off

  reflight
    entitled     Replacement                                    # F3B.1.5 e "the repetition is the official score"
    others       BetterOf                                       # F3B.1.5 e
    minNewGroup  param(minNewGroup)                             # F3B states no minimum, so the CD decides at setup (F12)

  penalty "safetyPlaneCrossing"  deduct 300  at FinalAggregate  # F3B.2.5 h "deduction from the competitor's final score"
  penalty "nonConformingWinch"   deduct 1000 at FinalAggregate  # F3B.2.2 p — note the rule ALSO zeroes the flight before the
                                                                #   test; the zero is not writable as a Penalty effect
                                                                #   combined with a deduction (recorded, unmodelled)

  # ========================================================================
  phase Preliminary mandatory

    rounds    FixedSequence tasksPerRound 3                     # F3B: a round is one flight of each of A, B and C
    validity  minRounds param(minRounds) minTasks 1             # F3B.1.8 b "one (1) round and one (1) task"
    drop      ByTask 1 whenCompleted >= 6                       # F3B.2.8 "if more than 5 complete rounds are flown, the lowest partial score of each task"

    # -- Task A — Duration -----------------------------------------------
    task A "Duration"                                           # F3B.2.3
      metric    flightTime          Number s Truncate 1         # F3B.2.3 b "each full second"
      metric    landingDistance     Number m Ceiling 1          # F3B.2.3 d "rounded to the nearest higher metre"
      metric    landedInDefinedArea Flag                        # F3B.2.3 b
      metric    atRestBy12Min       Flag                        # F3B.2.3 e
      flights   last                                            # F3B.1.5 unlimited attempts; the last is the attempt
      timing    Fixed 720 s maxLaunches unlimited               # F3B.2.3 a 12 min from the order of the starter, incl. towing
      group     minPerGroup 5 minValidResults 2                 # F3B.1.8 b (F7, adopted)
      normalise HigherIsBetter winner 1000                      # F3B.2.6 states no rounding precision, so none is applied (F12)
      score
        # Flight points and the overtime deduction are ONE cumulative
        # piecewise term over one metric, not two terms. 601 s scores 599.
        when landedInDefinedArea == true                        # F3B.2.3 b "if the model does not land on the defined landing area, the whole flight is zero"
          then piecewise flightTime
                 0..600    @  1 pt/s                            # F3B.2.3 b max 600 points
                 600..any  @ -1 pt/s                            # F3B.2.3 c one point deducted per full second over 600
          else constant 0
        # Landing bonus, forfeited three separate ways.
        when all(landedInDefinedArea == true,                   # F3B.2.3 b
                 flightTime <= 630,                             # F3B.2.3 d "no landing bonus if the flight time exceeds 630 seconds"
                 atRestBy12Min == true)                         # F3B.2.3 e
          then lookup landingDistance                           # F3B.2.3 d
                 <=  1 -> 100 ;  <=  2 -> 95 ;  <=  3 -> 90 ;  <=  4 -> 85
                 <=  5 ->  80 ;  <=  6 -> 75 ;  <=  7 -> 70 ;  <=  8 -> 65
                 <=  9 ->  60 ;  <= 10 -> 55 ;  <= 11 -> 50 ;  <= 12 -> 45
                 <= 13 ->  40 ;  <= 14 -> 35 ;  <= 15 -> 30 ;  any    ->  0
          else constant 0

    # -- Task B — Distance -----------------------------------------------
    task B "Distance"                                           # F3B.2.4
      metric    legs                Number legs Truncate 1      # F3B.2.4 e only full 150 m legs are counted
      metric    landedInDefinedArea Flag                        # F3B.2.4 f
      flights   last
      timing    Fixed 420 s maxLaunches unlimited               # F3B.2.4 a 7 min incl. towing (see finding F13 — the 4 min timed window inside it is not modelled)
      group     minPerGroup 3 minValidResults 2                 # F3B.1.8 b (F7, adopted)
      normalise HigherIsBetter winner 1000                      # F3B.2.6 — no precision stated (F12)
      score
        when landedInDefinedArea == true                        # F3B.2.4 f
          then rate legs 1 pt/leg                               # F3B.2.6 partial B is the leg count normalised
          else constant 0

    # -- Task C — Speed --------------------------------------------------
    # The inverted task. Note validWhen rather than a zero score: a raw zero
    # in a LowerIsBetter group is the fastest time in the group.
    task C "Speed"                                              # F3B.2.5
      metric    courseTime          Number s Truncate 0.01      # F3B.2.5 c "recorded to at least 1/100 sec"
      metric    courseCompleted     Flag                        # F3B.2.5 g "models which come to rest before having completed the task will score zero"
      metric    landedInDefinedArea Flag                        # F3B.2.5 f
      flights   last                                            # F3B.2.5 i re-launch permitted only before Base A is first crossed
      timing    Fixed 240 s maxLaunches unlimited               # F3B.2.5 a 4 min incl. towing
      group     minPerGroup 8 minValidResults 2                 # F3B.1.8 b "minimum 8 competitors or all competitors";
                                                                # (F7, adopted)
      normalise LowerIsBetter winner 1000                       # F3B.2.6 partial C = 1000 × T_winner / T_own; no precision stated (F12)
      validWhen all(courseCompleted == true,                    # F2 + F3, adopted
                    landedInDefinedArea == true)
      score
        rate courseTime 1 pt/s                                  # the raw result IS the elapsed time; the direction inverts it

# ---- unresolved for F3B --------------------------------------------------
# Tie-break (F3B.2.8: the tied competitors fly one additional full round) is not
# writable — it schedules more flying, which an ordered list of comparators
# cannot express. Finding F15.
#
# The Task-C rain provision (F3B.1.11 c: the field re-divided into 3–4 groups,
# evaluated per group) is a weather ruling made during a round, not a class
# rule; it lands on the Competition as a re-draw, not here. No model gap.
