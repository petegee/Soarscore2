# F5J — RC Electric Powered Thermal Duration Gliders    seed definition, draft
# Rule refs: FAI Sporting Code Volume F5 Electric 2026 ed.2 (5.5.11.x)
#
# The class that shows why PhaseDefinition owns its tasks: the fly-off is the
# same task with a different working time and a different points cap.

class F5J
  name     "RC Electric Powered Thermal Duration Gliders"
  fai      "F5J"
  version  "FAI F5 Electric 2026 ed.2"

  param flyoffMaxGroup Number default 14 boundAt CompetitionSetup   # 5.5.11.8 max 14; the CD may set a lower maximum
  param flyoffMinRounds Number no default boundAt CompetitionSetup  # 5.5.11 states no fly-off minimum (F12)

  finalRanking SplitByPromotion                                     # 5.5.11.13 qualifiers ranked on the fly-off, the rest on qualifying

  reflight
    entitled     Replacement                                        # 5.5.11.6
    others       BetterOf                                           # 5.5.11.6
    minNewGroup  6                                                  # 5.5.11.6 — 6, not the 4 used by F3J/F3K/F5K

  penalty "wrongLaunchDirection"      deduct 100  at FinalAggregate # 5.5.11.10 b
  penalty "motorBeforeStartSignal"    deduct 100  at FinalAggregate # 5.5.11.10 c
  penalty "launchNotStraightAhead3s"  deduct 100  at FinalAggregate # 5.5.11.10 e
  penalty "launchOutsideCorridor"     zeroRound   at RawScore       # 5.5.11.10 d — a zero score, NOT a 100-point deduction
  penalty "propellerTurningAfterRun"  zeroFlight  at RawScore       # 5.5.11.7 g
  penalty "safetyAreaInfringement"    deduct 300  at FinalAggregate # 5.5.11.4 c
  penalty "restsInAccessCorridor"     deduct 300  at FinalAggregate # 5.5.11.4 d
  penalty "contactInAccessCorridor"   deduct 1000 at FinalAggregate # 5.5.11.4 e
  # 5.5.11.4 a: all safety penalties are deducted from the final score and
  # listed on the round's score sheet — hence FinalAggregate throughout.
                                                                    # 5.5.11.12 n: all penalties cumulative, deducted at the end
                                                                    # of the preliminary rounds → PenaltyApplication.FinalAggregate

  metricSet f5jFlight
    metric flightTime          Number s Truncate 1                  # 5.5.11.12 b truncated to the nearest second
    metric startHeight         Number m Truncate 1                  # 5.5.11.12 d truncated to the nearest metre
    metric startHeightRecorded Flag                                 # 5.5.11.12 d flight = 0 if the AMRT records no start height
    metric landingDistance     Number m Truncate 0.1                # 5.5.11.12 i — the rules state no capture precision;
                                                                    #   MetricDefinition precision is not coverable by a
                                                                    #   Parameter (F12 residual). Chosen, not cited.
    metric overflySeconds      Number s Truncate 1                  # 5.5.11.12 g, k — seconds flown past the end of working time
    metric touchedByCompetitor Flag                                 # 5.5.11.12 j

  # ========================================================================
  phase Preliminary mandatory

    rounds    FixedSequence tasksPerRound 1
    validity  minRounds 4                                           # 5.5.11.13
    drop      ByRound 1 whenRounds >= 5                             # 5.5.11.13 "if more than 4, the lowest round score is dropped"

    task D "Duration"
      use       f5jFlight
      flights   last
      timing    Fixed 600 s maxLaunches unlimited                    # 5.5.11.8 working time 10 minutes
      group     minPerGroup 6                                        # 5.5.11.8
      normalise HigherIsBetter winner 1000                           # 5.5.11.12 m states no rounding precision, so none is applied (F12)
      # Both conditions zero THE FLIGHT, not one term (F17). Written as term
      # wrappers they had to be repeated on all three, and the start-height
      # deduction below is negative — so a long overfly scored 0 flight points,
      # 0 landing bonus and a NEGATIVE height deduction, when 5.5.11.12 g says
      # "a zero score will be recorded". Hoisted; behaviour on every other path
      # is unchanged, since all three terms already carried both conditions.
      flightValidWhen all(overflySeconds <= 60,                      # 5.5.11.12 g "zero score … for overflying by more than one (1) minute"
                          startHeightRecorded == true)               # 5.5.11.12 d
      score
        rate flightTime 1 pt/s cap 600 s                             # 5.5.11.12 c 1 pt per full second, max 600 points
        # Start-height deduction. Cumulative bands: 0.5/m for the first 200 m
        # and 3/m thereafter, so 220 m deducts 100 + 60 = 160, not 660.
        piecewise startHeight                                        # 5.5.11.12 e
          0..200    @ -0.5 pt/m
          200..any  @ -3   pt/m
        # Landing bonus — the coarser 50→0 table, forfeited two ways.
        when all(overflySeconds == 0,                                # 5.5.11.12 k
                 touchedByCompetitor == false)                       # 5.5.11.12 j
          then lookup landingDistance                                # 5.5.11.12 h
                 <=  1 -> 50 ;  <=  2 -> 45 ;  <=  3 -> 40 ;  <=  4 -> 35
                 <=  5 -> 30 ;  <=  6 -> 25 ;  <=  7 -> 20 ;  <=  8 -> 15
                 <=  9 -> 10 ;  <= 10 ->  5 ;  any   ->  0
          else constant 0

  # ========================================================================
  phase Flyoff optional                                              # 5.5.11.13

    promotion TopPercent 30 group 6..param(flyoffMaxGroup)
                carryPenalties false                                 # 5.5.11.12 n — F5J is the one class that STATES it
                                                                     # 5.5.11.13 top 30% rounded down; 5.5.11.8 single group 6–14;
                                                                     # 5.5.11.12 n penalties are not carried into the fly-off
    rounds    FixedSequence tasksPerRound 1
    validity  minRounds param(flyoffMinRounds)                       # not stated for F5J (F12)
    drop      none                                                   # 5.5.11.13 the discard applies to the qualifying aggregate

    # Same task; two numbers change, and both live on the task, which is why
    # the fly-off restates it rather than inheriting it.
    task D "Duration (fly-off)" like Preliminary.D
      timing  Fixed 900 s maxLaunches unlimited                      # 5.5.11.8 15 minutes
      flightValidWhen all(overflySeconds <= 60,                      # 5.5.11.12 g
                          startHeightRecorded == true)               # 5.5.11.12 d
      score
        rate flightTime 1 pt/s cap 900 s                             # 5.5.11.12 c 900 points for the fly-off rounds
        piecewise startHeight
          0..200    @ -0.5 pt/m                                      # 5.5.11.12 e
          200..any  @ -3   pt/m
        when all(overflySeconds == 0, touchedByCompetitor == false)
          then lookup landingDistance                                # 5.5.11.12 h
                 <=  1 -> 50 ;  <=  2 -> 45 ;  <=  3 -> 40 ;  <=  4 -> 35
                 <=  5 -> 30 ;  <=  6 -> 25 ;  <=  7 -> 20 ;  <=  8 -> 15
                 <=  9 -> 10 ;  <= 10 ->  5 ;  any   ->  0
          else constant 0

# ---- unresolved for F5J --------------------------------------------------
# Fly-off ties are broken by qualifying position (5.5.11.13) — a comparison
# against another figure, and the first of the two tie-break kinds the class
# diagram says are needed. Not writable. Finding F15.
