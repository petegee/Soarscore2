<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(SoarscoreTargetFramework)</TargetFramework>
    <RootNamespace>Soarscore.Infrastructure</RootNamespace>
  </PropertyGroup>

  <!-- LADR-0001 §4.1-3: this is the one project allowed to reference an event
       store at all. It now references two — Marten/PostgreSQL and Fisher/SQLite
       (kanban/completed/multi-backend-deployment.md). The adapter bodies
       (JasperFxEventStore.cs, the four Document*Query.cs, the four projection
       folds) are written against the JasperFx.Events shared contracts and name
       neither; what is per-store is a composition root and a handful of small
       subclasses. "A future SQLite adapter could reuse the fold logic unchanged"
       is what the previous version of this comment predicted, and it held.

       Both stores ship in one assembly rather than one per backend, so a SQLite
       deployment carries an Npgsql it never loads. That is a deliberate trade at
       this project's scale — see the story's "Deliberately not done". -->

  <ItemGroup>
    <PackageReference Include="Marten" />
    <!-- Transitive via Marten -> Weasel.Postgresql; declared explicitly because
         MartenEventStore.cs catches Npgsql.PostgresException directly (WI-7's
         error-translation rule: nothing Marten-shaped escapes this project, but
         the Postgres SqlState underneath it is the stable signal). -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Fisher" />
    <!-- Transitive via Fisher; declared explicitly for the exact counterpart
         reason Npgsql is — FisherEventStore.cs catches
         Microsoft.Data.Sqlite.SqliteException directly, because the SQLite
         extended result code underneath Fisher's wrapper is the stable signal. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soarscore.Application\Soarscore.Application.csproj" />
  </ItemGroup>

</Project>
